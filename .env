# Valores compartidos por todos los modos.
# Vite solo expone al bundle las variables con prefijo VITE_.
# Todo lo que pongas aqui viaja al navegador: nunca guardes secretos.

VITE_APP_NAME=FashionStore

# VITE_DECART_API_KEY (probador con IA, https://platform.decart.ai) no se versiona:
# en local va en .env.local y en Railway como Variable (build-arg del Dockerfile).
